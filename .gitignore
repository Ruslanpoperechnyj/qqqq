# ============================================================================
#  .gitignore для проекта ASM
#  Правило одно: в репозиторий идёт код и документы. Не идут данные заказчиков,
#  скачиваемый арсенал и логи прогонов.
# ============================================================================

# --- База результатов: цели, заказчики, основания, находки, журнал аудита,
# --- маски секретов. Это данные клиентов — в репозиторий нельзя.
asm.sqlite
asm.sqlite-journal
asm.sqlite-wal
asm.sqlite-shm
*.sqlite
*.sqlite3
*.db

# --- Арсенал ИБ (19 инструментов + шаблоны nuclei): ставится bin/install-tools.sh
build/
nuclei-templates/
semgrep-rules/

# --- Словари: их качает установщик, в репозитории им не место
data/wordlists/

# --- Отчёты и логи по реальным заказам
reports/
scan-*.log
*.log

# --- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# --- Ключи и локальные настройки
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Служебные кэши движков
.pdcp/
.cache/
wapiti-*
.nuclei-cache/

# --- ОС и редакторы
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
